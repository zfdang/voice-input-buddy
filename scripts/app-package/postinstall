#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/installation-common.sh"

# The App belongs to the desktop user, except Sparkle's privileged update helper.
# HAL drivers remain system-owned.
# An offline volume or login window has no local desktop owner to use.
if [[ "${3:-/}" == / ]]; then
    app='/Applications/Remote Buddy.app'
    buddy_check_bundle "$app" com.zfdang.remote-buddy
    if [[ -d "$app" ]]; then
        owner_uid="$(/usr/bin/stat -f '%u' /dev/console)"
        if [[ "$owner_uid" =~ ^[0-9]+$ && "$owner_uid" -ge 501 ]]; then
            owner_gid="$(/usr/bin/id -g "$owner_uid")"
            [[ "$owner_gid" =~ ^[0-9]+$ ]] || exit 1
            # Do not follow bundle symlinks into paths outside the installed App.
            /usr/sbin/chown -R -P -h "$owner_uid:$owner_gid" "$app"
            echo 'App ownership assigned to the logged-in desktop user.'
        else
            echo 'No desktop user; leaving system App ownership unchanged.'
        fi
        # Self-signed apps have no Apple Team ID. Sparkle therefore requires the
        # executable handling package updates to be root-owned inside the App.
        app_directory="$(cd -- "$app" && /bin/pwd -P)"
        helper_directory="$(cd -- "$app/Contents/Frameworks/Sparkle.framework/Versions/Current" && /bin/pwd -P)"
        case "$helper_directory/" in
            "$app_directory/Contents/Frameworks/Sparkle.framework/Versions/"*) ;;
            *) echo 'Refusing Sparkle helper outside the installed App.' >&2; exit 1 ;;
        esac
        helper="$helper_directory/Autoupdate"
        [[ -f "$helper" && ! -L "$helper" ]] || { echo 'Invalid Sparkle update helper.' >&2; exit 1; }
        /usr/sbin/chown -h 0:0 "$helper"
        echo 'Sparkle package update helper remains system-owned.'
    fi
fi

# Keep driver fingerprinting and conditional Core Audio restart in one place.
exec /bin/bash "$(dirname "$0")/driver-postinstall" "$@"
